# Public/client Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public application origin, e.g. https://app.example.com
PUBLIC_APP_URL=

# Shorts-Mation-owned Google OAuth application (customers never enter these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_STATE_SECRET=
TOKEN_ENCRYPTION_KEY=

# Shorts-Mation-owned render infrastructure (customers never enter these)
FFMPEG_WORKER_URL=
FFMPEG_WORKER_SECRET=
# Durable renderer queue (PostgreSQL/Supabase direct connection string)
RENDER_DATABASE_URL=
RENDER_DB_SSL=require
RENDER_WORK_ROOT=/var/lib/shorts-mation-render
RENDER_WORKER_ID=
RENDER_LEASE_SECONDS=45
RENDER_HEARTBEAT_MS=10000
RENDER_RECONCILE_MS=15000
RENDER_DRAIN_TIMEOUT_MS=30000
# Optional comma-separated additional trusted worker/CDN output hosts
RENDER_OUTPUT_HOSTS=
CRON_SECRET=

# Integration/certification resources
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_ROLE_KEY=
SUPABASE_TEST_DB_URL=
RUN_SUPABASE_INTEGRATION=0
E2E_BASE_URL=
E2E_EMAIL=
E2E_PASSWORD=
E2E_TEMPLATE_NAME=V2.14 Certification
E2E_EDITOR_PATH=
STAGING_CAMPAIGN_ID=
STAGING_SUPABASE_URL=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
STAGING_EXPECT_YOUTUBE_UPLOAD=1

# Local/offline fallback only. Keep false in production.
VITE_ENABLE_LEGACY_BROWSER_RENDERER=false
