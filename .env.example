# Public/client Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public application origin, e.g. https://app.example.com
PUBLIC_APP_URL=

# Shorts-Mation-owned Google OAuth application (customers never enter these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_STATE_SECRET=
TOKEN_ENCRYPTION_KEY=

# Shorts-Mation-owned render infrastructure (customers never enter these)
FFMPEG_WORKER_URL=
FFMPEG_WORKER_SECRET=
# Durable renderer queue (PostgreSQL/Supabase direct connection string)
RENDER_DATABASE_URL=
RENDER_DB_SSL=require
RENDER_WORK_ROOT=/tmp/shorts-mation-render
RENDER_WORKER_ID=
RENDER_LEASE_SECONDS=45
RENDER_HEARTBEAT_MS=10000
RENDER_RECONCILE_MS=15000
RENDER_DRAIN_TIMEOUT_MS=30000
RENDER_FRAME_SEGMENT_SIZE=50
RENDER_OUTPUT_URL_TTL_SECONDS=86400

# Cloudflare R2 durable render storage (server/worker only)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_RENDER_PREFIX=shorts-mation/render-v1
R2_MULTIPART_THRESHOLD_BYTES=67108864
R2_MULTIPART_PART_BYTES=16777216
# Optional comma-separated additional trusted worker/CDN output hosts
RENDER_OUTPUT_HOSTS=
CRON_SECRET=

# Integration/certification resources
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_ROLE_KEY=
SUPABASE_TEST_DB_URL=
RUN_SUPABASE_INTEGRATION=0
E2E_BASE_URL=
E2E_EMAIL=
E2E_PASSWORD=
E2E_TEMPLATE_NAME=V2.14 Certification
E2E_EDITOR_PATH=
STAGING_CAMPAIGN_ID=
STAGING_SUPABASE_URL=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
STAGING_EXPECT_YOUTUBE_UPLOAD=1

# Local/offline fallback only. Keep false in production.
VITE_ENABLE_LEGACY_BROWSER_RENDERER=false

# Phase 7 publisher orchestration. PUBLIC_APP_URL is optional: YouTube OAuth
# derives the live request origin when omitted. Set it in production when the
# app sits behind a proxy whose public origin differs from the request URL.
PUBLIC_APP_URL=
PUBLISH_JOBS_PER_TICK=2
PUBLISH_LEASE_SECONDS=180

# Phase 8 publisher fleet / direct R2 -> YouTube
PUBLISH_WORKER_ID=
PUBLISH_DRAINING=0
PUBLISH_JOBS_PER_TICK=2
PUBLISH_LEASE_SECONDS=180
YOUTUBE_UPLOAD_CHUNK_BYTES=8388608
# Test-only fault injection. Never set in production.
PUBLISH_CRASH_AFTER_CHECKPOINT=
# Live certification only
PHASE8_CERT_APP_URL=
PHASE8_CERT_ITEM_ID=
PHASE8_CERT_EXPECT_PUBLIC=0

# Phase 9 deployment control plane / operations
OPS_USER_IDS=
ALLOW_PUBLISH_FAULT_INJECTION=0
PUBLISH_TICK_SECONDS=5
SCHEDULER_TICK_SECONDS=30

# Phase 9 production certification (CI/staging only)
PHASE9_CERT_APP_URL=
PHASE9_CERT_ITEM_ID=
PHASE9_CRASH_ITEM_MAP=
PHASE9_REQUIRE_CRASH_MATRIX=1
PHASE9_RELEASE_SHA=
PHASE9_CERT_TIMEOUT_MS=2700000

# Phase 10 — multi-tenant governance and cost controls
# Estimated YouTube API quota reservation per new upload. Keep configurable
# because quota accounting policies can change independently of application code.
YOUTUBE_ESTIMATED_UPLOAD_QUOTA_UNITS=1600
# Number of due R2 lifecycle cleanup records processed by each scheduler leader tick.
R2_CLEANUP_PER_TICK=10

# Phase 11 billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTH=
STRIPE_PRICE_STARTER_YEAR=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_BUSINESS_MONTH=
STRIPE_PRICE_BUSINESS_YEAR=
BILLING_GRACE_HOURS=72
