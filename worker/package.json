{
  "name": "shortsforge-ffmpeg-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.mjs",
    "test": "node --test src/*.test.mjs",
    "certify:parity": "node scripts/pixel-parity-certify.mjs",
    "goldens:update": "node scripts/golden-render-suite.mjs --update",
    "certify:goldens": "node scripts/golden-render-suite.mjs",
    "certify:release": "npm test && npm run certify:goldens",
    "certify:queue": "node --test src/queue-store.test.mjs",
    "certify:queue:integration": "node scripts/durable-queue-certify.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "pg": "8.13.1"
  }
}
